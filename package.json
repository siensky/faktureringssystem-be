{
  "name": "faktureringssystem-be",
  "private": true,
  "type": "module",
  "workspaces": ["services/auth", "services/billing", "services/payments", "packages/*", "apps/*"],
  "scripts": {
    "migrate": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:redo": "bun run migrate:down && bun run migrate",
    "codegen": "bun run --cwd packages/contracts codegen",
    "test": "bun test packages services",
    "typecheck": "bash scripts/typecheck.sh",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test:e2e": "bun test e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/amqplib": "^0.10.5",
    "@types/bun": "latest",
    "amqplib": "^0.10.4",
    "postgres": "^3.4.9"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "node-pg-migrate": "^8.0.4"
  }
}
