# Kopiera till .env och fyll i riktiga värden lokalt. .env är gitignorat —
# committa aldrig riktiga hemligheter (git.md #9). Värdena här är exempel/
# dev-placeholders, inte production-hemligheter.

# ── Postgres ────────────────────────────────────────────────────────────
DB_USER=sienna
DB_PASSWORD=changeme-lokalt-losenord
DB_NAME=invoice_db
DB_EXTERNAL_PORT=5434
# Superuser — bara migrate/seed/postgres-init (infra) använder den här
# direkt. De fyra tjänsterna kopplar upp med sina egna, restriktiva roller
# nedan (fas 7, migrations/0008_service_roles.js).
DATABASE_URL=postgresql://sienna:changeme-lokalt-losenord@db:5432/invoice_db

# Fas 7: en Postgres-roll per tjänst, GRANT bara på egna tabeller
# (architecture.md, Tjänstegränser). Rollerna skapas av migrationen;
# infra/postgres/init.sh sätter LOGIN-lösenordet nedan (om-körbart, för
# rotation). Samma mönster som *_RABBITMQ_PASSWORD nedan.
AUTH_DB_PASSWORD=changeme-auth-db-losenord-minst-32-tecken
BILLING_DB_PASSWORD=changeme-billing-db-losenord-minst-32-tecken
PAYMENTS_DB_PASSWORD=changeme-payments-db-losenord-minst-32-tecken
DOCUMENTS_DB_PASSWORD=changeme-documents-db-losenord-minst-32-tecken

# ── Tjänsteportar (mappas ut lokalt för enkel felsökning, se docker-compose.yml) ──
AUTH_PORT=4001
BILLING_PORT=4002
PAYMENTS_PORT=4003
DOCUMENTS_PORT=4004

# ── RabbitMQ ────────────────────────────────────────────────────────────
# RABBITMQ_DEFAULT_USER/PASS är operatörskontot för management-UI:t
# (localhost:15672) och för att infra/rabbitmq/init.sh ska kunna skapa
# tjänstekontona. De fyra tjänsterna loggar in med sina EGNA konton
# (architecture.md, M2M: inget delat guest-konto).
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=changeme-lokalt-losenord
# Fast värde så entrypoint-skriptet slipper GENERERA och skriva
# .erlang.cookie vid varje uppstart — det skrivandet har visat sig kunna
# krascha containern med en eacces på vissa Docker-installationer.
RABBITMQ_ERLANG_COOKIE=changeme-erlang-cookie-nagot-langt-och-slumpmassigt
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

AUTH_RABBITMQ_PASSWORD=changeme-auth
BILLING_RABBITMQ_PASSWORD=changeme-billing
PAYMENTS_RABBITMQ_PASSWORD=changeme-payments
DOCUMENTS_RABBITMQ_PASSWORD=changeme-documents

# ── Redis ───────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── CORS ────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Loggning ────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── nginx ───────────────────────────────────────────────────────────────
NGINX_PORT=8080

# ── MinIO / S3 (fas 4) ──────────────────────────────────────────────────
# MinIO-ROOT: bara till MinIOs egen uppstart och till infra/minio/init.sh,
# som skapar bucketen och documents EGEN, bucket-begränsade nyckel.
# documents körs ALDRIG med de här — se DOCUMENTS_S3_* nedan.
MINIO_ROOT_USER=changeme-minio
MINIO_ROOT_PASSWORD=changeme-minio-losenord
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Bucket documents lägger PDF:er i, och det PUBLIKA S3-endpointet som
# signerade URL:er pekar på (måste vara nåbart från en webbläsare — inte
# minio:9000, som bara finns på Docker-nätet). Defaultas i docker-compose.yml.
S3_BUCKET=invoices
S3_REGION=us-east-1
S3_PUBLIC_ENDPOINT=http://localhost:9000
# Livslängd på en signerad PDF-URL (sekunder). Bärartoken — kort livstid.
PDF_URL_TTL_SECONDS=900
# documents S3-nyckel — SKILD från MinIO-root. infra/minio/init.sh skapar
# en MinIO-användare med exakt dessa uppgifter och en policy som bara
# tillåter Get/Put/List på S3_BUCKET (PR-granskning fas 4, punkt 13).
DOCUMENTS_S3_ACCESS_KEY_ID=documents-svc
DOCUMENTS_S3_SECRET_ACCESS_KEY=changeme-documents-s3-secret-minst-8-tecken

# ── Mailpit (fas 4) ─────────────────────────────────────────────────────
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# Avsändaradress på fakturamejl.
EMAIL_FROM=fakturor@faktura.test
# HMAC-hemlighet för POST /webhooks/email-status. Signaturen räknas över
# RÅ body (domain.md #25).                                 openssl rand -hex 32
EMAIL_WEBHOOK_SECRET=ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
# Mailpit lokalt/CI kör utan TLS/autentisering — lämna dessa tomma/false.
# En RIKTIG leverantör i produktion (SendGrid/Mailgun/SES/...) sätter
# SMTP_START_TLS=true och SMTP_USERNAME/SMTP_PASSWORD. Fakturor bär
# personuppgifter — klartext-SMTP mot en publik leverantör är fel.
SMTP_START_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=

# ── documents S2S-klient (fas 4) ────────────────────────────────────────
# documents hämtar snapshot/kund/företag från billing via ett tjänste-token.
# Raden i service_clients skapas av seed-containern (infra/seed) — aldrig i
# en migration (database.md #5). client_secret ska vara unikt och långt.
DOCUMENTS_CLIENT_ID=svc-documents
DOCUMENTS_CLIENT_SECRET=changeme-documents-client-secret-minst-32-tecken
DOCUMENTS_CLIENT_SCOPES=billing:invoice:read

# ── payments (fas 5) ────────────────────────────────────────────────────
# HMAC-hemlighet för POST /webhooks/payment (mockbanken). Signaturen
# räknas över RÅ body, samma konstruktion som EMAIL_WEBHOOK_SECRET.
#                                                            openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=gggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggg
# payments S2S-klient mot billing (bankgiro->tenant, OCR/id->faktura) —
# samma mönster som DOCUMENTS_CLIENT_*. Raden skapas av seed-containern.
PAYMENTS_CLIENT_ID=svc-payments
PAYMENTS_CLIENT_SECRET=changeme-payments-client-secret-minst-32-tecken
PAYMENTS_CLIENT_SCOPES=billing:company:read billing:invoice:read
# Drift-konto (INTE en tjänst) för BgMax-filimport och driftvyn för
# okänt bankgiro — utan den här klienten finns ingen väg för en riktig
# operatör att autentisera sig mot de endpointsen i en deployad miljö
# (PR-granskning fas 5, punkt 12).
PAYMENTS_OPS_CLIENT_ID=ops-payments
PAYMENTS_OPS_CLIENT_SECRET=changeme-payments-ops-client-secret-minst-32-tecken
PAYMENTS_OPS_CLIENT_SCOPES=payments:ops:import payments:ops:read

# ── billing (fas 6) ─────────────────────────────────────────────────────
# Drift-konto (INTE en tjänst) för POST /internal/automation/run — manuell
# körning av det dagliga jobbet (overdue, påminnelser, återkommande
# fakturor) utanför 03:00-schemat. Samma resonemang som PAYMENTS_OPS_CLIENT_*.
BILLING_OPS_CLIENT_ID=ops-billing
BILLING_OPS_CLIENT_SECRET=changeme-billing-ops-client-secret-minst-32-tecken
BILLING_OPS_CLIENT_SCOPES=billing:ops:run

# ── billing (fas 7) ─────────────────────────────────────────────────────
# billing SJÄLV (inte ett drift-konto) — GET /internal/ops/alerts anropar
# payments unknown-bankgiro-driftvy S2S i stället för att läsa dess tabell
# direkt (architecture.md #2). Samma mönster som PAYMENTS_CLIENT_*.
BILLING_CLIENT_ID=svc-billing
BILLING_CLIENT_SECRET=changeme-billing-client-secret-minst-32-tecken
BILLING_CLIENT_SCOPES=payments:ops:read

# ── Auth (fas 1–2) ────────────────────────────────────────────────────
# ALLA hemligheter nedan ska vara UNIKA värden. Placeholders här är bara
# illustrativa (a…, b…, c…) — generera riktiga lokalt.
NODE_ENV=development
# Aktiverar dev-endpoints (hämta verifieringstoken utan mejl). Ignoreras
# helt när NODE_ENV=production.
AUTH_DEV_ENDPOINTS=true
# BankID-provider: "mock" lokalt/CI. Måste vara "real" i produktion —
# mocken är en total auth-bypass.
BANKID_PROVIDER=mock
# Hårt per-IP-tak/min på login, register, reset, bankid/init. Höj i test.
AUTH_STRICT_RATE_LIMIT_MAX=10
# Grov global missbruksspärr, delad av auth/billing/payments
# (packages/shared/src/service/index.ts). 300 matchar kodens egen
# produktionsdefault — höj i test/CI (se .env), sänk aldrig i produktion.
RATE_LIMIT_MAX=300
# Signerar användar-JWT (HS256).            openssl rand -hex 48
JWT_USER_SECRET=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
# Signerar tjänste-JWT (M2M). Egen, skild från JWT_USER_SECRET.  hex 48
JWT_SERVICE_SECRET=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
# Peppar för HMAC-hash av refresh-/engångstokens. 64 hex.   openssl rand -hex 32
AUTH_TOKEN_PEPPER=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
# HMAC-nyckel för personnummer-hash (users.pnr_hash / customers.pnr_hmac).
# 64 hex. Aldrig samma som PNR_ENCRYPTION_KEY.              openssl rand -hex 32
PNR_HMAC_KEY=dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd
# AES-256-GCM-nyckel för kryptering av personnummer (fas 3). 64 hex.
# Aldrig samma som PNR_HMAC_KEY.                            openssl rand -hex 32
PNR_ENCRYPTION_KEY=eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee
